/////////////////////////////////////////////////////////////////////////////
// English (United States) resources

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
 PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "Powered by RIME | Rime Input Method Engine"
            VALUE "CompanyName", "Shishutang"
            VALUE "FileDescription", "Weasel Input Statistics Service"
            VALUE "FileVersion", FILE_VERSION
            VALUE "InternalName", "WeaselStats"
            VALUE "LegalCopyright", "Copyleft RIME Developers"
            VALUE "OriginalFilename", "WeaselStats.exe"
            VALUE "ProductName", "Weasel"
            VALUE "ProductVersion", STRZ(PRODUCT_VERSION)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
// Icon

// Keep the lowest icon resource ID consistent with WeaselServer.
IDI_WEASEL ICON "..\\resource\\weasel.ico"
